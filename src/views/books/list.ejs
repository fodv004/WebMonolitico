<%- include('../partials/head') %><div class="title"><h1>Catálogo de libros</h1><% if(user?.es_admin){ %><a class="button" href="/libros/nuevo">Nuevo libro</a><% } %></div><form class="search" method="get" action="/libros"><input type="text" name="q" placeholder="Buscar por ISBN o título…" value="<%= q %>"><button>Buscar</button><% if(q){ %><a class="button" href="/libros">Limpiar</a><% } %></form><div class="grid"><% items.forEach(book=>{ %><article class="book"><% if(book.portada){ %><img src="<%= book.portada %>" alt="Portada de <%= book.titulo %>"><% } %><div><h2><a href="/libros/<%= book.isbn %>"><%= book.titulo %></a></h2><p><%= book.autores %></p><p><%= book.formato %> · $<%= book.precio %> · Stock: <%= book.stock %></p></div></article><% }) %><% if(!items.length){ %><p><%= q?'No se encontraron libros para "'+q+'".':'Aún no hay libros registrados.' %></p><% } %></div><%- include('../partials/foot') %>
