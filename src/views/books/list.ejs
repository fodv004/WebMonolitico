<%- include('../partials/head') %><div class="title"><h1>Catálogo de libros</h1><% if(user?.es_admin){ %><a class="button" href="/libros/nuevo">Nuevo libro</a><% } %></div><div class="grid"><% items.forEach(book=>{ %><article class="book"><% if(book.portada){ %><img src="<%= book.portada %>" alt="Portada de <%= book.titulo %>"><% } %><div><h2><a href="/libros/<%= book.isbn %>"><%= book.titulo %></a></h2><p><%= book.autores %></p><p><%= book.formato %> · $<%= book.precio %> · Stock: <%= book.stock %></p></div></article><% }) %><% if(!items.length){ %><p>Aún no hay libros registrados.</p><% } %></div><%- include('../partials/foot') %>
