<%- include('../partials/head') %><div class="title"><div><h1><%= book.titulo %></h1><p>ISBN: <%= book.isbn %> · <%= book.anio_publicacion %> · $<%= book.precio %> · Stock: <%= book.stock %></p></div><% if(user?.es_admin){ %><a class="button" href="/libros/<%= book.isbn %>/editar">Editar</a><% } %></div><section class="card"><h2>Autores</h2><p><%= book.autores.map(x=>x.nombre).join(', ') || 'Sin autores' %></p><h2>Géneros</h2><p><%= book.generos.map(x=>x.nombre).join(', ') || 'Sin géneros' %></p></section><section class="card"><h2>Conceptos y definiciones</h2><% book.conceptos.forEach(x=>{ %><article><strong><%= x.nombre %></strong><p><%= x.definicion %></p><% if(user?.es_admin){ %><form method="post" action="/libros/<%= book.isbn %>/conceptos/<%= x.id_concepto %>/eliminar"><button class="danger">Quitar</button></form><% } %></article><% }) %><% if(user?.es_admin){ %><form class="form" method="post" action="/libros/<%= book.isbn %>/conceptos"><label>Concepto<select name="id_concepto"><% conceptos.forEach(x=>{ %><option value="<%= x.id_concepto %>"><%= x.nombre %></option><% }) %></select></label><label>Definición<textarea name="definicion" required></textarea></label><button>Guardar concepto</button></form><% } %></section><section class="card"><h2>Imágenes</h2><div class="gallery"><% book.imagenes.forEach(x=>{ %><figure><img src="<%= x.url %>" alt="Imagen del libro"><figcaption><%= x.es_principal?'Principal':'' %> <% if(user?.es_admin){ %><form method="post" action="/libros/<%= book.isbn %>/imagenes/<%= x.id_imagen %>/eliminar"><button class="danger">Eliminar</button></form><% } %></figcaption></figure><% }) %></div><% if(user?.es_admin){ %><form class="form" method="post" enctype="multipart/form-data" action="/libros/<%= book.isbn %>/imagenes"><label>Archivo de imagen (JPG, PNG o WebP, máx. 5MB)<input type="file" name="imagen" accept="image/jpeg,image/png,image/webp"></label><label>o URL externa<input type="url" name="url"></label><label>Orden<input type="number" name="orden" value="0"></label><label class="check"><input type="checkbox" name="es_principal"> Marcar como principal</label><button>Agregar imagen</button></form><form method="post" action="/libros/<%= book.isbn %>/eliminar"><button class="danger">Eliminar libro</button></form><% } %></section><%- include('../partials/foot') %>
