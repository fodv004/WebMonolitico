<%- include('../partials/head') %><div class="title"><h1>Usuarios</h1><a class="button" href="/usuarios/nuevo">Nuevo usuario</a></div><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Activo</th><th>Acciones</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><%= item.nombre %></td><td><%= item.correo %></td><td><%= item.es_admin?'Administrador':'Usuario' %></td><td><%= item.activo?'Sí':'No' %></td><td><a href="/usuarios/<%= item.id_usuario %>/editar">Editar</a><form class="inline" method="post" action="/usuarios/<%= item.id_usuario %>/eliminar"><button class="danger">Eliminar</button></form></td></tr><% }) %></tbody></table><%- include('../partials/foot') %>
